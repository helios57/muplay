<?xml version="1.0" encoding="utf-8"?>
<!--
  The two window colours the *platform* draws with, before a single Compose frame exists.

  These are not a second copy of the Compose palette in `:core:designsystem`. They cover the window
  that Android paints between `Activity` launch and the first composition — the gap
  `MuPlayTheme` cannot reach, because it does not exist yet. `muplay_window_background` is
  deliberately the same value as **MuPlay's own** `surface` for each mode — `MuPlaySurfaceLight`
  and `MuPlaySurfaceDark` in `:core:designsystem` — so the handover from the platform window to
  the first Compose frame is invisible rather than a flash of the wrong colour. They used to be
  Material 3's *baseline* surfaces (#FFFBFE / #1C1B1F), which is a different, purple-tinted
  palette: every dark cold start stepped from L=11 to L=6 in the Compose template's brand, and
  every light one arrived on a cooler white than the app's warm paper.

  The dark values live in `values-night/colors.xml`; that split is the whole fix for the
  light-only platform theme this replaced.
-->
<resources>
  <color name="muplay_window_background">#FBF9F5</color>
  <color name="muplay_splash_background">#005048</color>
</resources>
