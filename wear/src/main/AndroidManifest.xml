<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Declares this APK as a watch app. Play uses it to route the right APK to the right device.
       It does NOT stop `adb install` putting this APK on a phone image - uses-feature filters
       Play, not adb - which is why `ci/prepare-wear-emulator.sh` checks the device from outside
       and `WearSessionJourneyTest` asserts PackageManager.FEATURE_WATCH from inside. -->
  <uses-feature android:name="android.hardware.type.watch" />

  <!-- INTERNET, POST_NOTIFICATIONS, FOREGROUND_SERVICE(_MEDIA_PLAYBACK) and MuPlaybackService
       itself all arrive through :core:media's manifest, which put them there rather than in :app
       precisely so a second application module would get them without anyone copying four lines.
       `:wear:verifyDebugManifest` and `:wear:verifyReleaseManifest` prove that claim for this
       module, on every `check`, against AGP's own merged manifest - so the absence of those five
       declarations here is evidence, not an omission.

       No android:icon either, and that one IS deliberate rather than inherited: the phone's mark
       lives in app/src/main/res and is generated by ci/generate-launcher-icon.py, which writes
       there and nowhere else. Copying its four vector/mipmap files here would be a second copy of
       the same art with nothing keeping the two in step - exactly the shape this repository has
       paid for elsewhere. The watch launcher mark belongs with the watch surface, which is
       Task 9's work; until then the platform's default icon is used and lint's MissingApplicationIcon
       says so as a warning. -->

  <application
      android:name=".MuPlayWearApplication"
      android:allowBackup="false"
      android:label="MuPlay"
      android:supportsRtl="true"
      android:theme="@android:style/Theme.DeviceDefault">

    <!-- Standalone: this app works with the phone off, out of range, or an iPhone. A factual
         declaration, not an aspiration - the watch streams from Navidrome over its own Wi-Fi and
         never needs the phone to play. Task 10's credential transfer is a convenience on top of
         that, not a dependency of it. Lint's WearStandaloneAppFlag is an *error*-severity check on
         this meta-data being present and true. -->
    <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

    <uses-library android:name="com.google.android.wearable" android:required="false" />

    <activity
        android:name=".WearActivity"
        android:exported="true"
        android:label="MuPlay"
        android:taskAffinity=""
        android:theme="@android:style/Theme.DeviceDefault">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
