<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only, and the same reason as app/src/debug/AndroidManifest.xml: Tier 2 reaches the Navidrome
  container at http://localhost:4533 through `adb reverse`. `verifyReleaseManifest` fails the build
  if this ever reaches release, for this module exactly as for :app - the application convention
  plugin registers that task per variant, so :wear inherited the gate by existing.

  Note that on `targetSdk >= 28` the platform's default network security config already permits
  cleartext to `localhost` with or without this attribute (measured in Plan 8 Task 2, on a minified
  release APK). This is here for the general case, and `verifyReleaseManifest`'s guarantee should be
  read as "no cleartext to a REMOTE host" - which is the guarantee that matters.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:usesCleartextTraffic="true" />
</manifest>
